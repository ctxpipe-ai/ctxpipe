{
  "name": "@ctxpipe-dev/root",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bash scripts/dev-apps.sh",
    "dev:docs": "pnpm --filter @ctxpipe/docs dev",
    "dev:infra": "docker compose --profile infra up -d",
    "start": "docker compose --profile deploy up -d",
    "dev:backend": "pnpm --filter @ctxpipe/backend dev",
    "db:migrate": "pnpm --filter @ctxpipe/backend db:migrate",
    "build": "turbo build",
    "typecheck": "node scripts/ci/typecheck-all.mjs",
    "checks:list": "node scripts/checks/list.mjs",
    "checks:run": "node scripts/checks/run.mjs",
    "test:contracts": "node scripts/ci/test-suite.mjs contracts",
    "test:policy": "node scripts/ci/check-test-policy.mjs",
    "test:storybook-golden": "node scripts/ci/storybook-golden.mjs",
    "lint": "oxlint -c .oxlintrc.json apps packages",
    "knip": "pnpm dlx knip@5.88.1",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "mcp:inspect": "pnpm --filter @ctxpipe/backend run mcp:inspect",
    "mcpjam:inspect": "pnpm dlx @mcpjam/inspector@2.40.0",
    "mcpjam:doctor": "pnpm dlx @mcpjam/cli@3.24.0 server doctor",
    "mcpjam:login": "pnpm dlx @mcpjam/cli@3.24.0 oauth login",
    "mcpjam:protocol": "pnpm dlx @mcpjam/cli@3.24.0 protocol conformance",
    "mcpjam:oauth": "pnpm dlx @mcpjam/cli@3.24.0 oauth conformance",
    "mcpjam:tools": "pnpm dlx @mcpjam/cli@3.24.0 tools",
    "trust": "pnpm exec portless trust",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:prerelease": "changeset version --snapshot \"$SNAPSHOT_TAG\" && pnpm -r --filter \"./packages/*\" run --if-present build && pnpm -r --filter \"./packages/*\" run --if-present test && changeset publish --no-git-tag --tag \"$SNAPSHOT_TAG\"",
    "release": "pnpm -r --filter \"./packages/*\" run --if-present build && pnpm -r --filter \"./packages/*\" run --if-present test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "concurrently": "^9.1.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "portless": "^0.9.4",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "yaml": "2.8.2"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "^24"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "@daveyplate/better-auth-ui>better-call": "1.3.7",
      "@luma.gl/core": "9.2.6",
      "@luma.gl/engine": "9.2.6",
      "@luma.gl/webgl": "9.2.6",
      "@luma.gl/shadertools": "9.2.6",
      "@luma.gl/constants": "9.2.6"
    }
  }
}
