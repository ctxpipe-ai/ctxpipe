{
  "mcpServers": {
    "ctxpipe": {
      "type": "streamable-http",
      "url": "https://app.ctxpipe.ai/mcp?orgSlug=ctx-tev"
    },
    "ctxpipe-storybook": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:6006/mcp"
    },
    "hyperdx": {
      "type": "streamable-http",
      "url": "https://hyperdx.ctxpipe.ai/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:HYPERDX_ACCESS_KEY}"
      }
    },
    "cloudflare": {
      "type": "streamable-http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CLOUDFLARE_API_TOKEN_READONLY}"
      }
    }
  }
}
