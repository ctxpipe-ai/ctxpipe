{
  "mcpServers": {
    "ctxpipe": {
      "type": "streamable-http",
      "url": "https://app.ctxpipe.ai/mcp?orgSlug=ctx-tev"
    },
    "ctxpipe-storybook": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:6006/mcp"
    },
    "neon": {
      "type": "streamable-http",
      "url": "https://mcp.neon.tech/mcp?readonly=true"
    },
    "railway": {
      "type": "streamable-http",
      "url": "https://mcp.railway.com"
    },
    "hyperdx": {
      "type": "streamable-http",
      "url": "https://hyperdx.ctxpipe.dev/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:HYPERDX_ACCESS_KEY}",
        "CF-Access-Client-Id": "${env:HYPERDX_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${env:HYPERDX_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "cloudflare": {
      "type": "streamable-http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CLOUDFLARE_API_TOKEN_READONLY}"
      }
    }
  }
}
