{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "experimentalScannerIgnores": [
      ".nitro",
      "storybook-static",
      ".next",
      ".output",
      ".data",
      "schema.graphql"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "info"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/backend/src/**",
        "!apps/backend/src/openworkflow/defineObservedWorkflow.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "openworkflow": {
                    "importNames": ["defineWorkflow"],
                    "message": "Import defineWorkflow from openworkflow/defineObservedWorkflow.js. It sets the workflow logger."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/backend/src/services/linear/documents.generated.ts"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": ["apps/ui/src/styles.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["**/routeTree.gen.ts"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/ui/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
