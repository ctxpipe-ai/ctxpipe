{
  "name": "LLM (gen_ai)",
  "tags": ["ctxpipe", "llm"],
  "filters": [
    {
      "type": "QUERY_EXPRESSION",
      "name": "deployment.environment",
      "expression": "ResourceAttributes['deployment.environment']",
      "sourceName": "Traces"
    },
    {
      "type": "QUERY_EXPRESSION",
      "name": "ctxpipe.org.slug",
      "expression": "SpanAttributes['ctxpipe.org.slug']",
      "sourceName": "Traces"
    },
    {
      "type": "QUERY_EXPRESSION",
      "name": "enduser.id",
      "expression": "SpanAttributes['enduser.id']",
      "sourceName": "Traces"
    }
  ],
  "tiles": [
    {
      "name": "Calls",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceName": "Traces",
        "fillNulls": true,
        "seriesLimit": 20,
        "groupBy": "SpanAttributes['gen_ai.request.model']",
        "select": [
          {
            "aggFn": "count",
            "alias": "calls",
            "where": "mapContains(SpanAttributes, 'gen_ai.request.model') OR mapContains(SpanAttributes, 'gen_ai.operation.name')",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "Error rate",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceName": "Traces",
        "fillNulls": true,
        "asRatio": true,
        "seriesLimit": 20,
        "groupBy": "SpanAttributes['gen_ai.request.model']",
        "numberFormat": { "output": "percent", "mantissa": 1 },
        "select": [
          {
            "aggFn": "count",
            "alias": "errors",
            "where": "(mapContains(SpanAttributes, 'gen_ai.request.model') OR mapContains(SpanAttributes, 'gen_ai.operation.name')) AND StatusCode = 'Error'",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "count",
            "alias": "calls",
            "where": "mapContains(SpanAttributes, 'gen_ai.request.model') OR mapContains(SpanAttributes, 'gen_ai.operation.name')",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "Input tokens",
      "x": 0,
      "y": 8,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceName": "Traces",
        "fillNulls": true,
        "seriesLimit": 20,
        "groupBy": "SpanAttributes['gen_ai.request.model']",
        "select": [
          {
            "aggFn": "sum",
            "alias": "input tokens",
            "valueExpression": "toFloat64OrZero(SpanAttributes['gen_ai.usage.input_tokens'])",
            "where": "mapContains(SpanAttributes, 'gen_ai.usage.input_tokens')",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "Output tokens",
      "x": 12,
      "y": 8,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceName": "Traces",
        "fillNulls": true,
        "seriesLimit": 20,
        "groupBy": "SpanAttributes['gen_ai.request.model']",
        "select": [
          {
            "aggFn": "sum",
            "alias": "output tokens",
            "valueExpression": "toFloat64OrZero(SpanAttributes['gen_ai.usage.output_tokens'])",
            "where": "mapContains(SpanAttributes, 'gen_ai.usage.output_tokens')",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "Latency by model",
      "x": 0,
      "y": 16,
      "w": 24,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceName": "Traces",
        "fillNulls": true,
        "seriesLimit": 20,
        "groupBy": "SpanAttributes['gen_ai.request.model']",
        "numberFormat": { "output": "number", "mantissa": 1, "unit": "ms" },
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "alias": "p95 ms",
            "valueExpression": "Duration / 1000000",
            "where": "mapContains(SpanAttributes, 'gen_ai.request.model')",
            "whereLanguage": "sql"
          }
        ]
      }
    }
  ]
}
