{
  "name": "Observability Stack",
  "tags": ["ctxpipe", "observability"],
  "filters": [
    {
      "type": "QUERY_EXPRESSION",
      "name": "deployment.environment",
      "expression": "ResourceAttributes['deployment.environment']",
      "sourceName": "Metrics",
      "sourceMetricType": "gauge"
    }
  ],
  "savedFilterValues": [
    {
      "type": "sql",
      "condition": "ResourceAttributes['deployment.environment'] IN ('observability')"
    }
  ],
  "tiles": [
    {
      "name": "Collector spans per interval",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceName": "Metrics",
        "fillNulls": true,
        "groupBy": "ServiceName",
        "select": [
          {
            "aggFn": "increase",
            "alias": "accepted",
            "metricName": "otelcol_receiver_accepted_spans",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "increase",
            "alias": "refused",
            "metricName": "otelcol_receiver_refused_spans",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "increase",
            "alias": "sent",
            "metricName": "otelcol_exporter_sent_spans",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql"
          }
        ]
      }
    },
    {
      "name": "Collector exporter queue",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
