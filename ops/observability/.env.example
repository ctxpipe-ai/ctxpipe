# Copy to .env (gitignored). Never commit secrets.

# ClickHouse users (set the same values as Railway service variables)
CLICKHOUSE_OTEL_PASSWORD=
CLICKHOUSE_LANGFUSE_PASSWORD=

# ClickStack ingest token (apps send this as OTEL_EXPORTER_OTLP_HEADERS, e.g. authorization=<key>)
HYPERDX_API_KEY=

# Langfuse OTLP fan-out from the ClickStack collector
# LANGFUSE_OTLP_ENDPOINT is the Langfuse public OTEL base (…/api/public/otel)
# LANGFUSE_AUTH_STRING = base64("pk-lf-…:sk-lf-…")
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
LANGFUSE_AUTH_STRING=

# Langfuse web + worker (Postgres on Neon, blobs on a Railway bucket)
LANGFUSE_DATABASE_URL=
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=

HYPERDX_FRONTEND_URL=http://localhost:8080
