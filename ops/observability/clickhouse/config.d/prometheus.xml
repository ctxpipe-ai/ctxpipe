<clickhouse>
  <!-- Scrape target for the collector metrics/self pipeline (clickhouse.railway.internal:9363).
       The endpoint has no bind address of its own: it listens on every listen_host.
       clickhouse/clickhouse-server already sets listen_host to 0.0.0.0 and :: so
       Railway private networking (IPv6) and IPv4 can both reach /metrics. -->
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
  </prometheus>
</clickhouse>
