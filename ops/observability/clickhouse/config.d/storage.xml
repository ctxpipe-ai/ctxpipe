<clickhouse>
  <!-- One move at a time so an S3 upload does not stack buffers on the 1 GiB cap. -->
  <background_move_pool_size>1</background_move_pool_size>

  <storage_configuration>
    <disks>
      <s3_cold>
        <type>s3</type>
        <!-- Full URL, bucket and prefix included, trailing slash. -->
        <endpoint from_env="CLICKHOUSE_COLD_ENDPOINT"/>
        <access_key_id from_env="CLICKHOUSE_COLD_ACCESS_KEY_ID"/>
        <secret_access_key from_env="CLICKHOUSE_COLD_SECRET_ACCESS_KEY"/>
        <region from_env="CLICKHOUSE_COLD_REGION"/>
        <!-- Equal to the default, but the image entrypoint only creates and
             chowns directories listed as path/metadata_path; without it a
             fresh volume fails with Permission denied on disks/s3_cold. -->
        <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
        <!-- Fail the process if the bucket is unreachable at startup.
             skip_access_check=1 leaves the server up while tables that own
             cold parts stay failed (async_load_databases does not retry),
             so inserts and hot reads on those tables fail until a manual
             restart. Railway ON_FAILURE restarts until this check passes. -->
        <skip_access_check>0</skip_access_check>
        <request_timeout_ms>10000</request_timeout_ms>
        <retry_attempts>1</retry_attempts>
      </s3_cold>
      <s3_cold_cache>
        <type>cache</type>
        <disk>s3_cold</disk>
        <path>/var/lib/clickhouse/disks/s3_cold_cache/</path>
        <!-- The cache disk probes S3 itself. The flag on s3_cold does not cover it. -->
        <skip_access_check>0</skip_access_check>
        <max_size>268435456</max_size>
        <!-- Default is 10 million file entries. Bound it for the 1 GiB node. -->
        <max_elements>10240</max_elements>
      </s3_cold_cache>
    </disks>
    <policies>
      <!-- Replaces the built-in default policy. Volume `default` still holds
           disk `default`, so parts written before this file keep loading. -->
      <default>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
          <cold>
            <disk>s3_cold_cache</disk>
            <prefer_not_to_merge>1</prefer_not_to_merge>
            <perform_ttl_move_on_insert>0</perform_ttl_move_on_insert>
          </cold>
        </volumes>
        <!-- Move oldest parts when free space on the hot filesystem is under 20%. -->
        <move_factor>0.2</move_factor>
      </default>
      <!-- query_log and error_log. No cold volume. -->
      <local_only>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
        </volumes>
      </local_only>
    </policies>
  </storage_configuration>
</clickhouse>
