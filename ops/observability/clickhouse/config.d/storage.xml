<clickhouse>
  <!-- One move at a time. Each move uploads a part to S3; parallel moves
       would stack buffers on the 1 GiB memory cap. -->
  <background_move_pool_size>1</background_move_pool_size>

  <storage_configuration>
    <disks>
      <s3_cold>
        <type>s3</type>
        <!-- Full URL, bucket and prefix included, trailing slash. Path-style
             or virtual-hosted. Railway wiring builds the path-style form. -->
        <endpoint from_env="CLICKHOUSE_COLD_ENDPOINT"/>
        <access_key_id from_env="CLICKHOUSE_COLD_ACCESS_KEY_ID"/>
        <secret_access_key from_env="CLICKHOUSE_COLD_SECRET_ACCESS_KEY"/>
        <region from_env="CLICKHOUSE_COLD_REGION"/>
        <!-- Metadata stays on the local volume. Losing the volume orphans
             the objects; a bucket listing is not a table. -->
        <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
        <!-- A down bucket must not block process start. Inserts land on
             the hot volume (perform_ttl_move_on_insert is off). -->
        <skip_access_check>1</skip_access_check>
        <!-- Railway documents single-object Delete, not DeleteObjects. -->
        <support_batch_delete>0</support_batch_delete>
        <request_timeout_ms>60000</request_timeout_ms>
        <connect_timeout_ms>10000</connect_timeout_ms>
        <retry_attempts>3</retry_attempts>
        <!-- Cap in-flight PUTs so a multipart upload stays small. -->
        <s3_max_put_rps>10</s3_max_put_rps>
        <s3_max_put_burst>2</s3_max_put_burst>
        <s3_max_get_rps>20</s3_max_get_rps>
        <s3_max_get_burst>4</s3_max_get_burst>
      </s3_cold>
      <s3_cold_cache>
        <type>cache</type>
        <disk>s3_cold</disk>
        <path>/var/lib/clickhouse/disks/s3_cold_cache/</path>
        <!-- The cache disk probes S3 on startup by writing a few bytes.
             skip_access_check on s3_cold does not cover that probe. -->
        <skip_access_check>1</skip_access_check>
        <max_size>268435456</max_size>
        <max_file_segment_size>8388608</max_file_segment_size>
        <max_elements>10240</max_elements>
        <load_metadata_threads>2</load_metadata_threads>
        <cache_on_write_operations>0</cache_on_write_operations>
      </s3_cold_cache>
    </disks>
    <policies>
      <!-- Replaces the built-in default policy. Volume `default` still holds
           disk `default`, so parts written before this file keep loading.
           New MergeTree tables (ClickStack, Langfuse migrations) use this
           policy without a per-table storage_policy setting. -->
      <default>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
          <cold>
            <disk>s3_cold_cache</disk>
            <prefer_not_to_merge>1</prefer_not_to_merge>
            <perform_ttl_move_on_insert>0</perform_ttl_move_on_insert>
          </cold>
        </volumes>
        <!-- Safety valve: move the oldest parts once free space on the
             hot filesystem is under 20% (~40 GiB of the 50 GiB volume).
             Day-to-day moves are the TTL, not this ratio. -->
        <move_factor>0.2</move_factor>
      </default>
      <!-- query_log and error_log. No cold volume, so they cannot be moved. -->
      <local_only>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
        </volumes>
      </local_only>
    </policies>
  </storage_configuration>
</clickhouse>
