# Database
DATABASE_URL=postgresql://ctxpipe:ctxpipe@localhost:5433/ctxpipe
GRAPH_DB_URI=redis://localhost:6379
# Required, must be >= 32 characters.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000

# OpenTelemetry — optional. Unset keeps logs on stdout and skips export.
# Full OTLP/HTTP signal URLs, same names as the backend.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=codesearch
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# Exported service.name is always codesearch. deployment.environment is
# RAILWAY_ENVIRONMENT_NAME, else NODE_ENV, unless OTEL_RESOURCE_ATTRIBUTES sets it.

# Zoekt RPC (inside Docker container from start.sh; default 6070)
ZOEKT_WEBSERVER_URL=http://127.0.0.1:6070

# Optional: index + clone dirs (defaults from `pnpm dev` via dev-apps.sh → apps/codesearch/.data/)
# ZOEKT_INDEX_DIR=/absolute/path/to/zoekt-index
# REPO_CACHE_DIR=/absolute/path/to/repo-cache
# Max concurrent Zoekt/SCIP child processes (default 2). Compose deploy uses 1 (small).
# CODESEARCH_INDEXER_CONCURRENCY=2
# Max distinct repos with in-flight OpenWorkflow index-phase HTTP, clone included (default 2).
# CODESEARCH_INDEX_PIPELINE_CONCURRENCY=2
