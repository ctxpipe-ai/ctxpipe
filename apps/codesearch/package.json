{
  "name": "@ctxpipe/codesearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ZOEKT_WEBSERVER_URL=${ZOEKT_WEBSERVER_URL:-http://127.0.0.1:6070} portless codesearch.ctxpipe bun run --hot src/server.ts",
    "build": "tsc",
    "start": "bun run dist/server.js",
    "test": "bash scripts/run-vitest-docker.sh",
    "test:manual:kubernetes-memory": "bash scripts/manual-kubernetes-ingest-memory.sh",
    "test:vitest": "vitest run --exclude src/domain/repositories/globFiles.test.ts && bun --bun vitest run src/domain/repositories/globFiles.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.26.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@scalar/hono-api-reference": "^0.9.44",
    "drizzle-orm": "beta",
    "evlog": "^2.13.0",
    "hono": "^4.12.1",
    "jose": "^6.1.3",
    "pg": "^8.18.0",
    "protobufjs": "^8.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "msw": "^2.13.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
