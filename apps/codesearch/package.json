{
  "name": "@ctxpipe/codesearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ZOEKT_WEBSERVER_URL=${ZOEKT_WEBSERVER_URL:-http://127.0.0.1:6070} portless codesearch.ctxpipe bun run --hot src/server.ts",
    "build": "bun build ./src/server.ts --target=bun --packages=external --outdir=dist",
    "start": "bun run dist/server.js",
    "test": "bash scripts/run-vitest-docker.sh",
    "test:manual:kubernetes-memory": "bash scripts/manual-kubernetes-ingest-memory.sh",
    "test:vitest": "node scripts/run-vitest-contracts.mjs",
    "cutover:export-indexes": "bun src/cutover/exportIndexes.ts",
    "cutover:import-indexes": "bun src/cutover/importIndexes.ts",
    "cutover:verify-graph": "bun src/cutover/verifyGraph.ts",
    "cutover:seed-shard-store": "bun src/cutover/seedShardStore.ts",
    "cutover:reset-indexes": "bun src/cutover/resetIndexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@hono/otel": "^1.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/baggage-span-processor": "^0.6.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.1",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@scalar/hono-api-reference": "^0.12.0",
    "drizzle-orm": "beta",
    "evlog": "^2.13.0",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "pg": "^8.18.0",
    "protobufjs": "^8.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.16.0",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
