@startuml
left to right direction
skinparam componentStyle rectangle
package "Frontend" {
  [Web UI] as web
  [Admin console] as admin
}
package "Backend" {
  [REST API] as api
  [Auth service] as auth
  [Search indexer] as indexer
}
package "Data" {
  database "MySQL" as mysql
  database "Elasticsearch" as es
  [Object storage] as blob
}
web --> api : JSON
admin --> api
api --> auth : validate token
api --> mysql
api --> blob : uploads
indexer --> mysql : read changes
indexer --> es : index
api --> es : query
@enduml
