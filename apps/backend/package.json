{
  "name": "@ctxpipe/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/checks/prerequisites.mjs converter && concurrently -n backend,worker \"NODE_TLS_REJECT_UNAUTHORIZED=0 portless app.ctxpipe bun run --hot src/server.ts\" \"pnpm run openworkflow:worker\"",
    "build": "bun build ./src/server.ts --target=bun --packages=external --outdir=dist",
    "start": "bun run dist/server.js",
    "test": "node ../../scripts/ci/test-suite.mjs backend",
    "test:latency": "vitest run --config vitest.latency.config.ts",
    "test:upgrade-from-release": "vitest run --config vitest.upgrade.config.ts",
    "test:connector-assets": "vitest run --config vitest.connector-assets.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/auth/cli.ts --output ./src/db/schema/auth.ts -y",
    "auth:migrate": "pnpm dlx auth@latest migrate --config ./src/auth/cli.ts --yes",
    "db:migrate": "bash ../../scripts/db-migrate.sh",
    "migrate": "pnpm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "mcp:inspect": "pnpm dlx @modelcontextprotocol/inspector --config ../../.cursor/mcp.json --server ctxpipe",
    "openworkflow:worker": "bunx @openworkflow/cli worker start",
    "openworkflow:dashboard": "pnpm dlx @openworkflow/cli dashboard --port 8000",
    "openworkflow:doctor": "pnpm dlx @openworkflow/cli doctor",
    "rerun-skill-derivation": "bun run src/scripts/rerunSkillDerivation.ts",
    "graph-quality-report": "bun run src/scripts/graphQualityReport.ts",
    "ingestion-compare": "bun run src/scripts/ingestionCompare.ts",
    "import-public-github-issues": "bun --no-env-file run src/scripts/importPublicGithubIssues.ts",
    "reindex-repositories": "bun run src/scripts/reindexRepositories.ts",
    "migrate-workspace-sources": "bun run src/scripts/migrateWorkspaceSources.ts",
    "verify-instruction-ingestion": "bun run src/scripts/verifyInstructionIngestion.ts",
    "verify-connector-assets-runtime": "bun run src/scripts/verifyConnectorAssetRuntime.ts",
    "codegen:linear": "graphql-codegen --config codegen.linear.yml"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1077.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1077.0",
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "@better-auth/api-key": "^1.7.25",
    "@better-auth/infra": "^0.4.30",
    "@better-auth/oauth-provider": "^1.7.25",
    "@better-auth/passkey": "^1.7.25",
    "@clickhouse/client": "^1.25.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hono/mcp": "^0.3.5",
    "@hono/otel": "^1.3.0",
    "@hono/zod-openapi": "1.6.3",
    "@infisical/agent-vault-sdk": "^0.7.0",
    "@linear/sdk": "^102.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/webhooks": "^14.2.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/instrumentation-http": "^0.223.2",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.1",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.223.2",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@openworkflow/cli": "^0.5.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@scalar/hono-api-reference": "^0.12.0",
    "@scure/base": "^2.0.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@smithy/node-http-handler": "^4.9.1",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-opencode": "0.4.14",
    "@tanstack/ai-persistence": "^0.7.1",
    "@tanstack/ai-sandbox": "^0.5.17",
    "@tanstack/ai-sandbox-docker": "^0.3.2",
    "@tanstack/ai-sandbox-local-process": "^0.2.6",
    "@toon-format/toon": "^4.0.0",
    "better-auth": "^1.7.25",
    "dockerode": "^5.0.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "beta",
    "evlog": "^2.13.0",
    "falkordb": "^6.6.2",
    "graphql": "^17.1.0",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "neo4j-driver": "^6.0.1",
    "node-html-markdown": "^2.0.0",
    "nodemailer": "^10.6.0",
    "octokit": "^5.0.5",
    "openworkflow": "0.10.1",
    "pg": "^8.18.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3",
    "yaml": "^2.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ctxpipe/visual-review": "workspace:*",
    "@forge/cli": "^13.4.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@mcpjam/sdk": "^10.0.0",
    "@modelcontextprotocol/conformance": "^0.1.15",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@smithy/eventstream-codec": "^4.5.2",
    "@tanstack/ai-client": "^0.36.0",
    "@types/bun": "^1.3.9",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "beta",
    "msw": "^2.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
