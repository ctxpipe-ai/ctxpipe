#!/usr/bin/env node
// ctxpipe-finish: write patch.json for the staged tree and the recorded
// deletes. The base blob of a file is the one ctxpipe-stage recorded, else
// the blob at the base commit. Unchanged staged files make no op.
import { writeFileSync } from "node:fs"
import { join } from "node:path"
import {
  baseBlob,
  contentBlob,
  currentStep,
  fail,
  parseArgs,
  readDeletes,
  readStaged,
  stagedFile,
  stagedPaths,
} from "./stage-lib.mjs"

const { root } = parseArgs()
const step = currentStep(root)
const recorded = readStaged(step)
const ops = []
const staged = new Set(stagedPaths(step))
for (const path of staged) {
  const blob = path in recorded ? recorded[path] : baseBlob(step, path)
  if (!blob) ops.push({ op: "create", path })
  else if (contentBlob(step, stagedFile(step, path)) !== blob)
    ops.push({ op: "update", path, baseBlob: blob })
}
for (const [path, entry] of Object.entries(readDeletes(step))) {
  if (staged.has(path)) fail(`${path} is both staged and deleted`)
  ops.push({
    op: "delete",
    path,
    baseBlob: entry.baseBlob,
    reason: entry.reason,
  })
}
ops.sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0))
writeFileSync(
  join(step.stepDir, "patch.json"),
  `${JSON.stringify({ ops }, null, 2)}\n`,
)
const count = (op) => ops.filter((o) => o.op === op).length
process.stdout.write(
  `patch.json: ${count("create")} create, ${count("update")} update, ${count("delete")} delete\n`,
)
