#!/usr/bin/env node
// ctxpipe-delete <path> --reason "<text>": record the delete of a context
// file. A staged copy of the file is removed.
import {
  baseBlob,
  contextPath,
  currentStep,
  fail,
  readDeletes,
  removeStaged,
  writeDeletes,
} from "./stage-lib.mjs"

const args = process.argv.slice(2)
const at = args.indexOf("--reason")
const reason = at === -1 ? "" : (args[at + 1] ?? "").trim()
if (!reason) fail('Give a reason: ctxpipe-delete <path> --reason "<text>"')
const target = args.find((arg, index) => index !== at && index !== at + 1)
const step = currentStep()
const path = contextPath(step, target)
const blob = baseBlob(step, path)
if (!blob) fail(`${path} is not a file in the context checkout`)
removeStaged(step, path)
writeDeletes(step, { ...readDeletes(step), [path]: { baseBlob: blob, reason } })
process.stdout.write(`Delete recorded: ${path}\n`)
