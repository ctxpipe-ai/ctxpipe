{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decisions result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "total",
    "done",
    "waiting",
    "more",
    "decisions",
    "stale",
    "skipped"
  ],
  "properties": {
    "repository": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Decision files that the script read, over all pages."
    },
    "done": {
      "type": "integer",
      "minimum": 0,
      "description": "Decision files whose context file this run already wrote (earlier pages)."
    },
    "waiting": {
      "type": "integer",
      "minimum": 0,
      "description": "Decision files that wait: no context file of this run at the step base, and none staged with no problem."
    },
    "more": {
      "type": "boolean",
      "description": "The list ends at its size limit: write the listed files, run --check, and run the script again for the next ones."
    },
    "decisions": {
      "type": "array",
      "description": "The decision files that wait, in the run order, up to the size limit of the list.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "metadata",
          "name",
          "title",
          "number",
          "status",
          "statusText",
          "date",
          "target",
          "write",
          "existing",
          "scope",
          "influences",
          "supersedes",
          "related"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "The decision file in the source repository."
          },
          "metadata": {
            "type": ["string", "null"],
            "description": "The metadata file of a KEP (kep.yaml) in the source repository, or null."
          },
          "name": {
            "type": "string",
            "description": "The name for the front matter."
          },
          "title": {
            "type": "string"
          },
          "number": {
            "type": ["integer", "null"]
          },
          "status": {
            "enum": [
              "accepted",
              "proposed",
              "draft",
              "provisional",
              "implementable",
              "implemented",
              "postponed",
              "withdrawn",
              "deprecated",
              "superseded",
              "rejected",
              "undeclared"
            ]
          },
          "statusText": {
            "type": ["string", "null"]
          },
          "date": {
            "type": ["string", "null"]
          },
          "target": {
            "type": "string",
            "description": "The context file to write."
          },
          "write": {
            "enum": ["create", "update", "additive"]
          },
          "existing": {
            "type": ["string", "null"]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "roots"],
            "properties": {
              "basis": {
                "enum": ["package", "reference", "repository"]
              },
              "roots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "influences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Service files, relative to the target: INFLUENCES claims."
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to", "evidence"],
              "properties": {
                "to": {
                  "type": "string",
                  "description": "The replaced decision file, relative to the target."
                },
                "evidence": {
                  "type": "string",
                  "description": "The source file that declares it."
                }
              }
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Context files of this source whose decision file has left the source."
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
