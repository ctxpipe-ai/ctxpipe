{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discover-roots result",
  "type": "object",
  "additionalProperties": false,
  "required": ["roots", "ambiguous"],
  "properties": {
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "manifests", "evidence"],
        "properties": {
          "path": { "type": "string" },
          "manifests": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "ambiguous": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "reason", "candidates"],
        "properties": {
          "manifest": { "type": ["string", "null"] },
          "reason": { "type": "string" },
          "candidates": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
