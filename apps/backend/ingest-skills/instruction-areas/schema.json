{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "instruction-areas result",
  "type": "object",
  "additionalProperties": false,
  "required": ["ops", "skipped", "more"],
  "properties": {
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": { "enum": ["create", "update", "delete"] },
          "path": { "type": "string" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    },
    "more": {
      "type": "boolean",
      "description": "Always false: a repository follows at most 15 areas, so one step holds them."
    }
  }
}
