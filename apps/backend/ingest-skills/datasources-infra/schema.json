{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "datasources-infra find-stores result",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "stores", "infrastructure", "skipped"],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rule"],
      "properties": {
        "path": { "type": "string" },
        "rule": {
          "enum": [
            "manifest-dependency",
            "connection-scheme",
            "orm-config",
            "compose-image",
            "manifest-image",
            "helm-dependency",
            "terraform-resource",
            "cloudformation-resource",
            "cdk-construct",
            "iac-file"
          ]
        },
        "detail": {
          "type": "string",
          "description": "A safe identifier: a package, a variable name, a resource address. Never a value."
        }
      }
    },
    "existing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owned"],
        "properties": {
          "path": { "type": "string" },
          "title": { "type": "string" },
          "owned": { "type": "boolean" }
        }
      }
    }
  },
  "properties": {
    "root": { "type": "string" },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "name",
          "category",
          "evidence",
          "evidenceTotal",
          "existing"
        ],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          },
          "evidenceTotal": { "type": "integer" },
          "existing": { "$ref": "#/$defs/existing" }
        }
      }
    },
    "infrastructure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "evidence", "evidenceTotal", "existing"],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          },
          "evidenceTotal": { "type": "integer" },
          "existing": { "$ref": "#/$defs/existing" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
