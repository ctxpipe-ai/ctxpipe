{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "readmes result",
  "type": "object",
  "additionalProperties": false,
  "required": ["ops", "skipped", "more"],
  "properties": {
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": {
            "const": "update"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "more": {
      "type": "boolean",
      "description": "True when the step stopped at 30 files. The host runs the skill again on the new base."
    }
  }
}
