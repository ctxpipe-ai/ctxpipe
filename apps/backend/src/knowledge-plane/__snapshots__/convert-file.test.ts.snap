exports[`convertFile > converts sample.docx to Markdown 1`] = `
{
  "imageOnlyPages": [],
  "kind": "text",
  "text": "# Incident review: cache outage

The cache cluster lost its primary at 09:12 UTC.

1. Fail over to the replica
2. Rebuild the primary
3. Write the postmortem

| Metric | Value |
| --- | --- |
| Downtime | 14 minutes |
| Requests lost | 0 |
",
}
`;

