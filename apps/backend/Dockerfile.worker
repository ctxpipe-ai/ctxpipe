# Build from monorepo root: docker build -f apps/backend/Dockerfile.worker .
# Runs the OpenWorkflow durable-job worker process (not the HTTP server).
# Install Forge CLI here so npm/layout matches official Node layout; copying/npm in the Bun
# stage and then RUN npm caused "Cannot find module '../lib/cli.js'" when invoking /usr/local/bin/npm.
FROM node:24.22.1-alpine AS nodeforge
RUN npm install -g @forge/cli@13.4.0

FROM oven/bun:1.4.4-alpine AS deps
WORKDIR /app
ENV CI=true
# pnpm is a Node CLI. Running it through Bun can stall during lifecycle scripts.
RUN apk add --no-cache nodejs
RUN bun install -g pnpm@10.12.1
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.json ./
COPY patches patches
COPY apps/backend/package.json apps/backend/package.json
RUN pnpm install --frozen-lockfile --prod --config.confirmModulesPurge=false

FROM oven/bun:1.4.4-alpine
WORKDIR /app
ENV CI=true
ENV NODE_ENV=production
ENV PATH="/usr/local/bin:${PATH}"
# git: clone-tree and paste-URL hydrate spawn the git CLI.
RUN apk add --no-cache git
# Node 24 + global @forge/cli from stage above (directories copied together; do not RUN npm here).
COPY --from=nodeforge /usr/local/bin/ /usr/local/bin/
COPY --from=nodeforge /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/backend/node_modules ./apps/backend/node_modules
COPY tsconfig.json ./
COPY shared ./shared
COPY apps/backend/src ./apps/backend/src
COPY apps/backend/ingest-skills ./apps/backend/ingest-skills
COPY apps/backend/openworkflow.config.ts ./apps/backend/openworkflow.config.ts
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/backend/tsconfig.json ./apps/backend/tsconfig.json

# The supervisor idle-exits when the OpenWorkflow queue is empty (PR previews set
# OPENWORKFLOW_IDLE_EXIT_SECONDS); elsewhere it starts the worker and waits.
# It runs under Node, not Bun: a Bun panic in this long-lived process stopped a
# healthy worker (CTX-971). The worker child is the OpenWorkflow CLI under Node.
RUN cd /app/apps/backend && bun build src/openworkflow/worker-supervisor.ts --target=node --packages=external --outfile=dist/worker-supervisor.mjs
CMD ["sh", "-c", "cd /app/apps/backend && exec node dist/worker-supervisor.mjs"]
