{
  "mcpServers": {
    "ctxpipe": {
      "type": "http",
      "url": "https://app.ctxpipe.ai/mcp?orgSlug=ctx-tev",
      "headers": {
        "x-api-key": "${CTXPIPE_API_KEY:-}"
      }
    },
    "ctxpipe-storybook": {
      "type": "http",
      "url": "http://127.0.0.1:6006/mcp"
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp?readonly=true",
      "headers": {
        "Authorization": "Bearer ${NEON_API_KEY:-}"
      }
    },
    "railway": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@railway/cli@5.63.1", "mcp", "local"]
    },
    "langfuse": {
      "type": "http",
      "url": "https://langfuse.ctxpipe.ai/api/public/mcp",
      "headers": {
        "Authorization": "Basic ${LANGFUSE_AUTH_STRING:-}"
      }
    }
  }
}
