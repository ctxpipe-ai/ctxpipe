{
  "mcpServers": {
    "ctxpipe": {
      "type": "http",
      "url": "https://app.ctxpipe.ai/mcp?orgSlug=ctx-tev",
      "headers": {
        "x-api-key": "${CTXPIPE_API_KEY:-}"
      }
    },
    "ctxpipe-storybook": {
      "type": "http",
      "url": "http://127.0.0.1:6006/mcp"
    },
    "hyperdx": {
      "type": "http",
      "url": "https://hyperdx.ctxpipe.dev/api/mcp",
      "headers": {
        "Authorization": "Bearer ${HYPERDX_ACCESS_KEY:-}",
        "CF-Access-Client-Id": "${HYPERDX_CF_ACCESS_CLIENT_ID:-}",
        "CF-Access-Client-Secret": "${HYPERDX_CF_ACCESS_CLIENT_SECRET:-}"
      }
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN_READONLY:-}"
      }
    }
  }
}
