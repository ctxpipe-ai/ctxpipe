+    "/**\n * Boot an `opencode serve` HTTP server INSIDE a sandbox and expose its port so\n * the host `@opencode-ai/sdk` client can connect over `baseUrl`. Mirrors the\n * SDK's own server launch (`opencode serve --hostname=H --port=P`, ready when\n * stdout logs `opencode server listening`).\n */\nimport type { SandboxHandle, SpawnHandle } from '@tanstack/ai-sandbox'\n\nconst READY_MARKER = 'opencode server listening'\nconst DIAGNOSTIC_TAIL_LIMIT = 2_000\nconst READY_SCAN_LIMIT = 16_000\nconst STOP_TERM_TIMEOUT_MS = 1_000\nconst STOP_KILL_TIMEOUT_MS = 5_000\n\ntype ProcessExit =\n  | { ok: true; exitCode: number }\n  | { ok: false; error: unknown }\n\nexport interface SandboxOpencodeServer {\n  /** URL the host uses to reach the in-sandbox server. */\n  baseUrl: string\n  /**\n   * Headers that authenticate requests to {@link baseUrl}, when the provider's\n   * channel is token-gated (e.g. Daytona's `x-daytona-preview-token`). The host\n   * opencode client must send these on every request or the preview proxy 404s.\n   */\n  headers?: Record<string, string>\n  /** Bounded process diagnostics for failures after the server is ready. */\n  diagnostics: () => string\n  /** Stop the server process. */\n  dispose: () => Promise<void>\n}\n\nexport interface StartServerOptions {\n  port: number\n  hostname?: string\n  cwd: string\n  /** Extra env for the server process (e.g. `OPENCODE_CONFIG_CONTENT`). */\n  env?: Record<string, string>\n  timeoutMs?: number\n  signal?: AbortSignal\n}\n\nexport async function startOpencodeServerInSandbox(\n  sandbox: SandboxHandle,\n  options: StartServerOptions,\n): Promise<SandboxOpencodeServer> {\n  const hostname = options.hostname ?? '0.0.0.0'\n  const command = `opencode serve --hostname=${hostname} --port=${options.port}`\n  const proc: SpawnHandle = await sandbox.process.spawn(command, {\n    cwd: options.cwd,\n    ...(options.env ? { env: options.env } : {}),\n    ...(options.signal ? { signal: options.signal } : {}),\n  })\n\n  // Observe wait exactly once. Besides preventing an unhandled rejection, this\n  // keeps the exit code available after readiness for later SDK failures.\n  const processExit = proc.wait().then<ProcessExit>(\n    (exitCode) => ({ ok: true, exitCode }),\n    (error) => ({ ok: false, error }),\n  )\n\n  let port: number\n  let readiness: Awaited<ReturnType<typeof waitForReady>>\n  try {\n    readiness = await waitForReady(\n      proc,\n      processExit,\n      options.timeoutMs ?? 30_000,\n    )\n    port = readiness.port\n  } catch (error) {\n    throw await preserveFailure(error, proc, processExit)\n  }\n\n  let channel: Awaited<ReturnType<SandboxHandle['ports']['connect']>>\n  try {\n    channel = await sandbox.ports.connect(port)\n  } catch (error) {\n    throw await preserveFailure(error, proc, processExit)\n  }\n  // Carry the channel's auth so the host client can reach a token-gated preview.\n  // Prefer ready-made `headers`; fall back to a bearer token if that's all the\n  // provider issued.\n  const headers =\n    channel.headers ??\n    (channel.token ? { Authorization: `Bearer ${channel.token}` } : undefined)\n  let disposeTask: Promise<void> | undefined\n  const dispose = (): Promise<void> => disposeTask ??= (async () => {\n    const failures: Array<unknown> = []\n    try { await channel.close?.() } catch (error) { failures.push(error) }\n    try { await stopProcess(proc, processExit) } catch (error) { failures.push(error) }\n    if (failures.length === 1) throw failures[0]\n    if (failures.length > 1) throw new AggregateError(failures, 'OpenCode preview and process cleanup failed')\n  })()\n  try { options.signal?.throwIfAborted() } catch (error) {\n    try { await dispose() } catch (cleanup) {\n      throw new AggregateError([error, cleanup], 'OpenCode startup aborted and cleanup failed')\n    }\n    throw error\n  }\n  return {\n    baseUrl: channel.url,\n    ...(headers ? { headers } : {}),\n    diagnostics: readiness.diagnostics,\n    dispose,\n  }\n}\n\nasync function stopProcess(\n  proc: SpawnHandle,\n  processExit: Promise<ProcessExit>,\n): Promise<void> {\n  const terminateFailures: Array<unknown> = []\n  const waitForExit = async (phase: string, timeoutMs: number): Promise<void> => {\n    const result = await waitForProcess(processExit, phase, timeoutMs)\n    if (!result.ok) throw result.error\n  }\n  try {\n    await waitForProcess(\n      proc.kill(),\n      'terminate signal',\n      STOP_TERM_TIMEOUT_MS,\n    )\n  } catch (error) {\n    terminateFailures.push(error)\n  }\n\n  try {\n    await waitForExit('exit after terminate', STOP_TERM_TIMEOUT_MS)\n    return\n  } catch (graceError) {\n    const escalationFailures: Array<unknown> = [\n      ...terminateFailures,\n      graceError,\n    ]\n    try {\n      await waitForProcess(\n        proc.kill('SIGKILL'),\n        'SIGKILL signal',\n        STOP_KILL_TIMEOUT_MS,\n      )\n    } catch (killError) {\n      escalationFailures.push(killError)\n    }\n    try {\n      await waitForExit('exit after SIGKILL', STOP_KILL_TIMEOUT_MS)\n    } catch (waitError) {\n      escalationFailures.push(waitError)\n      throw new AggregateError(\n        escalationFailures,\n        'OpenCode process cleanup failed',\n      )\n    }\n  }\n}\n\nasync function waitForProcess<T>(\n  operation: Promise<T>,\n  phase: string,\n  timeoutMs: number,\n): Promise<T> {\n  let timer: ReturnType<typeof setTimeout> | undefined\n  try {\n    return await Promise.race([\n      operation,\n      new Promise<never>((_, reject) => {\n        timer = setTimeout(\n          () =>\n            reject(\n              new Error(\n                `OpenCode process did not ${phase} within ${timeoutMs}ms`,\n              ),\n            ),\n          timeoutMs,\n        )\n      }),\n    ])\n  } finally {\n    if (timer !== undefined) clearTimeout(timer)\n  }\n}\n\nasync function preserveFailure(\n  original: unknown,\n  proc: SpawnHandle,\n  processExit: Promise<ProcessExit>,\n): Promise<never> {\n  try {\n    await stopProcess(proc, processExit)\n  } catch (cleanup) {\n    throw new AggregateError(\n      [original, cleanup],\n      'OpenCode startup failed and process cleanup failed',\n    )\n  }\n  throw original\n}\n\nfunction waitForReady(\n  proc: SpawnHandle,\n  processExit: Promise<ProcessExit>,\n  timeoutMs: number,\n): Promise<{ port: number; diagnostics: () => string }> {\n  return new Promise<{ port: number; diagnostics: () => string }>((resolve, reject) => {\n    let stdout = ''\n    let stderr = ''\n    let readyScan = ''\n    let reportedUrl: string | undefined\n    let exitResult: ProcessExit | undefined\n    let stdoutError: unknown\n    let stderrError: unknown\n    // Holder object so reads stay typed as `boolean` across async closures\n    // (a plain `let` gets flow-narrowed to a literal and trips lint).\n    const state = { settled: false }\n    const settle = (fn: () => void): void => {\n      if (state.settled) return\n      state.settled = true\n      clearTimeout(timer)\n      fn()\n    }\n    const tail = (value: string, chunk: string): string =>\n      `${value}${chunk}`.slice(-DIAGNOSTIC_TAIL_LIMIT)\n    const diagnostics = (): string => {\n      const details = [\n        reportedUrl ? `reportedURL=${safeDiagnosticUrl(reportedUrl)}` : '',\n        exitResult\n          ? exitResult.ok\n            ? `exitCode=${exitResult.exitCode}`\n            : `exitError=${safeDiagnosticText(errorMessage(exitResult.error))}`\n          : '',\n        stdout.trim() ? `stdout=${safeDiagnosticText(stdout.trim())}` : '',\n        stderr.trim() ? `stderr=${safeDiagnosticText(stderr.trim())}` : '',\n        stdoutError ? `stdoutError=${safeDiagnosticText(errorMessage(stdoutError))}` : '',\n        stderrError ? `stderrError=${safeDiagnosticText(errorMessage(stderrError))}` : '',\n      ].filter(Boolean)\n      return details.join(' | ')\n    }\n    void processExit.then((result) => {\n      exitResult = result\n    })\n    const timer = setTimeout(\n      () =>\n        settle(() =>\n          reject(\n            new Error(\n              `opencode serve did not become ready within ${timeoutMs}ms${\n                diagnostics() ? `: ${diagnostics()}` : ''\n              }`,\n            ),\n          ),\n        ),\n      timeoutMs,\n    )\n\n    // Drain both streams for the whole process lifetime. Readiness is one\n    // event, but session creation can fail later and still needs the tail.\n    void (async () => {\n      try {\n        for await (const chunk of proc.stderr) stderr = tail(stderr, chunk)\n      } catch (error) {\n        stderrError = error\n      }\n    })()\n\n    void (async () => {\n      try {\n        for await (const chunk of proc.stdout) {\n          stdout = tail(stdout, chunk)\n          readyScan = `${readyScan}${chunk}`.slice(-READY_SCAN_LIMIT)\n          if (readyScan.includes(READY_MARKER)) {\n            const match = readyScan.match(\n              /opencode server listening on (https?:\\/\\/[^\\s]+)\\r?\\n/,\n            )\n            if (!match) continue\n            reportedUrl = match[1]\n            let readyUrl: URL\n            try {\n              readyUrl = new URL(match[1])\n            } catch {\n              settle(() =>\n                reject(\n                  new Error(\n                    `opencode serve reported an invalid readiness URL: ${match[1]}`,\n                  ),\n                ),\n              )\n              return\n            }\n            const port = Number(readyUrl.port)\n            if (!Number.isInteger(port) || port <= 0 || port > 65_535) {\n              settle(() =>\n                reject(\n                  new Error(\n                    `opencode serve reported an invalid readiness port: ${readyUrl.port || '(missing)'}`,\n                  ),\n                ),\n              )\n              return\n            }\n            settle(() => resolve({ port, diagnostics }))\n          }\n        }\n        if (!state.settled) {\n          const result = await processExit\n          exitResult = result\n          settle(() =>\n            reject(\n              new Error(\n                `opencode serve exited before becoming ready${\n                  diagnostics() ? `: ${diagnostics()}` : ' (no output)'\n                }`,\n              ),\n            ),\n          )\n        }\n      } catch (error) {\n        stdoutError = error\n        settle(() => reject(error))\n      }\n    })()\n  })\n}\n\nfunction errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error)\n}\n\nfunction safeDiagnosticText(value: string): string {\n  return value\n    .replace(/Bearer\\s+\\S+/gi, 'Bearer [redacted]')\n    .replace(\n      /(authorization|api[-_ ]?key|token|password|secret)\\s*[:=]\\s*\\S+/gi,\n      '$1=[redacted]',\n    )\n    .slice(-DIAGNOSTIC_TAIL_LIMIT)\n}\n\nfunction safeDiagnosticUrl(value: string): string {\n  try {\n    const url = new URL(value)\n    url.username = ''\n    url.password = ''\n    url.search = ''\n    url.hash = ''\n    return url.toString()\n  } catch {\n    return '[invalid URL]'\n  }\n}\n"
