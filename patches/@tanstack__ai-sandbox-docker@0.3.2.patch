+  const revokeIngress = (id) => {
+    const grant = ingressGrants.get(id);
+    if (!grant)
+      return;
+    ingressGrants.delete(id);
+    clearTimeout(grant.expires);
+    for (const abort of grant.aborters)
+      abort();
+  };
