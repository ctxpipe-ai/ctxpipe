+// src/egress-proxy.ts
+import { randomUUID, timingSafeEqual } from "node:crypto";
+import { lookup } from "node:dns/promises";
+import { mkdir, chmod, unlink } from "node:fs/promises";
+import { createServer, request } from "node:http";
+import { connect, createServer as createTcpServer, isIP } from "node:net";
+import { dirname } from "node:path";
+import { domainToASCII } from "node:url";
+var CONTROL_SOCKET = "/tmp/tanstack-egress/control.sock";
+var GRANT_TTL_MS = 10 * 60000;
+var MAX_CONNECTIONS = 256;
+var HOP_HEADERS = new Set([
+  "connection",
+  "keep-alive",
+  "proxy-authenticate",
+  "proxy-authorization",
+  "proxy-connection",
+  "te",
+  "trailer",
+  "transfer-encoding",
+  "upgrade"
+]);
+function asPort(value, label) {
+  if (!Number.isInteger(value) || value < 1 || value > 65535)
+    throw new Error(`egress: ${label} must be a TCP port`);
+  return value;
+}
+function normalizeHost(value) {
+  const trimmed = value.trim().replace(/^\[|\]$/g, "");
+  if (!trimmed || /[/?#@]/.test(trimmed))
+    throw new Error("egress: invalid host");
+  if (isIP(trimmed))
+    return trimmed.toLowerCase();
+  const ascii = domainToASCII(trimmed);
+  if (!ascii)
+    throw new Error("egress: invalid host");
+  return ascii.toLowerCase();
+}
+function authorityKey(host, port) {
+  return `${host.includes(":") ? `[${host}]` : host}:${port}`;
+}
+function normalizeAuthority(input) {
+  return { host: normalizeHost(input.host), port: asPort(input.port, "port") };
+}
+function normalizeRules(rules) {
+  return rules.map((rule) => {
+    const authority = normalizeAuthority(rule);
+    const paths = new Set(rule.paths.map((path) => {
+      if (!path.startsWith("/") || path.includes("?") || path.includes("#"))
+        throw new Error("egress: HTTP allowlist paths must be exact paths");
+      return path;
+    }));
+    if (paths.size === 0)
+      throw new Error("egress: HTTP allowlist rule has no paths");
+    return { ...authority, paths };
+  });
+}
+function forbiddenIpv4(value) {
+  if (/^(?:169\.254\.|127\.|0\.)/.test(value))
+    return true;
+  if (value === "100.100.100.200")
+    return true;
+  const octets = value.split(".").map(Number);
+  return octets.length === 4 && octets.every((part) => Number.isInteger(part) && part >= 0 && part <= 255) && octets[0] >= 224;
+}
+function ipv6Words(value) {
+  let text = value.toLowerCase().replace(/^\[|\]$/g, "");
+  const dotted = text.match(/(^|:)(\d+\.\d+\.\d+\.\d+)$/);
+  if (dotted) {
+    const parts = dotted[2].split(".").map(Number);
+    if (parts.some((part) => !Number.isInteger(part) || part < 0 || part > 255))
+      return;
+    text = `${text.slice(0, -dotted[2].length)}${(parts[0] << 8 | parts[1]).toString(16)}:${(parts[2] << 8 | parts[3]).toString(16)}`;
+  }
+  if (!text.includes(":"))
+    return;
+  const halves = text.split("::");
+  if (halves.length > 2)
+    return;
+  const left = halves[0] ? halves[0].split(":") : [];
+  const right = halves.length === 2 && halves[1] ? halves[1].split(":") : [];
+  if (left.concat(right).some((part) => !/^[0-9a-f]{1,4}$/.test(part)))
+    return;
+  const words = [...left, ...halves.length === 2 ? Array(8 - left.length - right.length).fill("0") : [], ...right].map((part) => Number.parseInt(part, 16));
+  return words.length === 8 ? words : undefined;
+}
+function embeddedIpv4(value) {
+  const words = ipv6Words(value);
+  if (!words)
+    return;
+  const first = words.slice(0, 5).every((word) => word === 0);
+  const mapped = first && (words[5] === 0 || words[5] === 65535);
+  const nat64 = words.slice(0, 6).every((word, index) => word === (index === 0 ? 100 : index === 1 ? 65435 : 0));
+  const sixToFour = words[0] === 8194;
+  if (!mapped && !nat64 && !sixToFour)
