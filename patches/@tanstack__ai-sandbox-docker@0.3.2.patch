+      mounts[0]?.Type === 'tmpfs' && mounts[0].Destination === '/tmp'
+    if (
+      !user || user === 'root' || user === '0' || user.startsWith('0:') ||
+      host.Privileged === true ||
+      host.CapDrop?.length !== 1 || host.CapDrop[0] !== 'ALL' ||
+      (host.CapAdd?.length ?? 0) !== 0 ||
+      host.SecurityOpt?.length !== 1 || host.SecurityOpt[0] !== 'no-new-privileges:true' ||
+      (host.Devices?.length ?? 0) !== 0 ||
+      (Array.isArray(values.DeviceRequests) && values.DeviceRequests.length > 0) ||
+      (host.Binds?.length ?? 0) !== 0 ||
+      (Array.isArray(values.Mounts) && values.Mounts.length > 0) ||
+      (mounts.length > 0 && !mountsAreOwnedTmpfs) ||
+      host.LogConfig?.Type !== 'none'
+    ) throw new Error(`docker: ${resource} does not satisfy the owned egress boundary`)
+  }
