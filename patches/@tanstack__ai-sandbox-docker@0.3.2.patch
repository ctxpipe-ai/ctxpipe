+import { createServer, request, type ServerResponse, type IncomingMessage } from 'node:http'
+import { connect, createServer as createTcpServer, isIP, type Server, type Socket } from 'node:net'
+import { dirname } from 'node:path'
+import { domainToASCII } from 'node:url'
+
+const CONTROL_SOCKET = '/tmp/tanstack-egress/control.sock'
+const GRANT_TTL_MS = 10 * 60_000
+const MAX_CONNECTIONS = 256
+const HOP_HEADERS = new Set([
+  'connection', 'keep-alive', 'proxy-authenticate', 'proxy-authorization',
+  'proxy-connection', 'te', 'trailer', 'transfer-encoding', 'upgrade',
+])
+
+export interface EgressAuthority { host: string; port: number }
+export interface EgressHttpRule extends EgressAuthority { paths: Array<string> }
+export interface EgressIngress { listenPort: number; targetPort: number }
+
+/** Static policy consumed by the provider and serialized into the proxy env. */
+export interface DockerSandboxEgressPolicy {
+  proxyImage: string
+  allowConnect: Array<EgressAuthority>
+  allowHttp: Array<EgressHttpRule>
+  ingress?: Array<EgressIngress>
+}
+
+export interface EgressProxyOptions {
+  allowConnect: Array<EgressAuthority>
+  allowHttp: Array<EgressHttpRule>
+  ingressTargetHost: string
+  ingress?: Array<EgressIngress>
+  bindAddress?: string
+  ingressBindAddress?: string
+  proxyPort?: number
+  controlSocketPath?: string
+}
+
+export interface EgressProxyHandle {
+  readonly proxyPort: number
+  readonly controlSocketPath: string
+  readonly ingressPorts: Array<number>
+  close: () => Promise<void>
+}
+
+type StaticHttpRule = { host: string; port: number; paths: ReadonlySet<string> }
+type Grant = { host: string; port: number; path: '/mcp'; token: string; aborters: Set<() => void>; expires: ReturnType<typeof setTimeout> }
+type IngressGrant = { targetPort: number; token: string; aborters: Set<() => void>; expires: ReturnType<typeof setTimeout> }
+
+function asPort(value: unknown, label: string): number {
+  if (!Number.isInteger(value) || (value as number) < 1 || (value as number) > 65535)
+    throw new Error(`egress: ${label} must be a TCP port`)
+  return value as number
+}
+
+function normalizeHost(value: string): string {
+  const trimmed = value.trim().replace(/^\[|\]$/g, '')
+  if (!trimmed || /[/?#@]/.test(trimmed)) throw new Error('egress: invalid host')
+  if (isIP(trimmed)) return trimmed.toLowerCase()
+  const ascii = domainToASCII(trimmed)
+  if (!ascii) throw new Error('egress: invalid host')
+  return ascii.toLowerCase()
+}
+
+function authorityKey(host: string, port: number): string {
+  return `${host.includes(':') ? `[${host}]` : host}:${port}`
+}
+
+function normalizeAuthority(input: EgressAuthority): EgressAuthority {
+  return { host: normalizeHost(input.host), port: asPort(input.port, 'port') }
+}
+
+function normalizeRules(rules: Array<EgressHttpRule>): Array<StaticHttpRule> {
+  return rules.map((rule) => {
+    const authority = normalizeAuthority(rule)
+    const paths = new Set(rule.paths.map((path) => {
+      if (!path.startsWith('/') || path.includes('?') || path.includes('#'))
+        throw new Error('egress: HTTP allowlist paths must be exact paths')
+      return path
+    }))
+    if (paths.size === 0) throw new Error('egress: HTTP allowlist rule has no paths')
+    return { ...authority, paths }
+  })
+}
+
+function forbiddenIpv4(value: string): boolean {
+  if (/^(?:169\.254\.|127\.|0\.)/.test(value)) return true
+  if (value === '100.100.100.200') return true
+  const octets = value.split('.').map(Number)
+  return octets.length === 4 && octets.every((part) => Number.isInteger(part) && part >= 0 && part <= 255) && octets[0] >= 224
+}
+
+function ipv6Words(value: string): Array<number> | undefined {
+  let text = value.toLowerCase().replace(/^\[|\]$/g, '')
+  const dotted = text.match(/(^|:)(\d+\.\d+\.\d+\.\d+)$/)
+  if (dotted) {
+    const parts = dotted[2].split('.').map(Number)
+    if (parts.some((part) => !Number.isInteger(part) || part < 0 || part > 255)) return undefined
+    text = `${text.slice(0, -dotted[2].length)}${((parts[0] << 8) | parts[1]).toString(16)}:${((parts[2] << 8) | parts[3]).toString(16)}`
+  }
+  if (!text.includes(':')) return undefined
+  const halves = text.split('::')
+  if (halves.length > 2) return undefined
+  const left = halves[0] ? halves[0].split(':') : []
+  const right = halves.length === 2 && halves[1] ? halves[1].split(':') : []
+  if (left.concat(right).some((part) => !/^[0-9a-f]{1,4}$/.test(part))) return undefined
+  const words = [...left, ...(halves.length === 2 ? Array(8 - left.length - right.length).fill('0') : []), ...right].map((part) => Number.parseInt(part, 16))
+  return words.length === 8 ? words : undefined
+}
+
+function embeddedIpv4(value: string): string | undefined {
+  const words = ipv6Words(value)
+  if (!words) return undefined
+  const first = words.slice(0, 5).every((word) => word === 0)
+  const mapped = first && (words[5] === 0 || words[5] === 0xffff)
+  const nat64 = words.slice(0, 6).every((word, index) => word === (index === 0 ? 0x0064 : index === 1 ? 0xff9b : 0))
+  const sixToFour = words[0] === 0x2002
+  if (!mapped && !nat64 && !sixToFour) return undefined
+  const high = sixToFour ? words[1] : words[6]
+  const low = sixToFour ? words[2] : words[7]
+  return `${high >> 8}.${high & 255}.${low >> 8}.${low & 255}`
+}
+
+function forbiddenAddress(address: string): boolean {
+  const value = address.toLowerCase().replace(/^\[|\]$/g, '')
+  if (!value.includes(':')) return forbiddenIpv4(value)
+  const embedded = embeddedIpv4(value)
+  if (embedded && forbiddenIpv4(embedded)) return true
+  if (value === '::1' || value === '::' || value === 'fd00:ec2::254') return true
+  if (/^fe[89a-f][0-9a-f]:/.test(value) || /^ff[0-9a-f]{2}:/.test(value)) return true
+  return false
+}
+
+async function resolveSafe(host: string): Promise<string> {
+  const addresses = await lookup(host, { all: true, verbatim: true })
+  if (addresses.length === 0 || addresses.some(({ address }) => forbiddenAddress(address)))
+    throw new Error('egress: destination address denied')
+  const address = addresses[0]?.address
+  if (!address) throw new Error('egress: destination address unavailable')
+  return address
+}
+
+function compareToken(actual: string | undefined, expected: string): boolean {
+  if (!actual) return false
+  const left = Buffer.from(actual)
+  const right = Buffer.from(expected)
+  return left.length === right.length && timingSafeEqual(left, right)
+}
+
+function cleanHeaders(headers: IncomingMessage['headers']): Record<string, string | string[]> {
+  const clean: Record<string, string | string[]> = {}
+  const nominated = new Set(String(headers.connection ?? '').split(',').map((name) => name.trim().toLowerCase()).filter(Boolean))
+  for (const [name, value] of Object.entries(headers)) {
+    if (value !== undefined && !HOP_HEADERS.has(name.toLowerCase()) && !nominated.has(name.toLowerCase())) clean[name] = value
+  }
+  return clean
+}
+
+function parseTarget(raw: string | undefined): { host: string; port: number; path: string; url: string } | undefined {
+  if (!raw) return undefined
+  let parsed: URL
+  try { parsed = new URL(raw) } catch { return undefined }
+  if (parsed.protocol !== 'http:' || parsed.username || parsed.password || parsed.hash)
+    return undefined
+  if (parsed.search) return undefined
+  const host = normalizeHost(parsed.hostname)
+  const port = parsed.port ? asPort(Number(parsed.port), 'port') : 80
+  const path = parsed.pathname || '/'
+  return { host, port, path, url: `http://${authorityKey(host, port)}${path}` }
+}
+
+function parseAuthority(raw: string | undefined): EgressAuthority | undefined {
+  if (!raw || raw.includes('/') || raw.includes('?') || raw.includes('#')) return undefined
+  try {
+    const parsed = new URL(`http://${raw}`)
+    if (parsed.username || parsed.password || parsed.pathname !== '/' || !parsed.port) return undefined
+    return normalizeAuthority({ host: parsed.hostname, port: Number(parsed.port) })
+  } catch { return undefined }
+}
+
+function sendStatus(res: ServerResponse, status: number, body = ''): void {
+  if (!res.headersSent) res.writeHead(status, { connection: 'close' })
+  res.end(body)
+}
+
+function bearerToken(value: string | undefined): string | undefined {
+  const match = typeof value === 'string' ? /^Bearer ([^\s]+)$/.exec(value) : undefined
+  return match?.[1]
+}
+
+function methodAllowed(path: string, method: string | undefined): boolean {
+  const verb = method?.toUpperCase()
+  if (path.endsWith('/models')) return verb === 'GET' || verb === 'HEAD'
+  if (path.endsWith('/chat/completions')) return verb === 'POST'
+  return verb === 'GET' || verb === 'HEAD'
+}
+
+function responseCleanup(res: ServerResponse, cleanup: () => void): void {
+  let done = false
+  const finish = (): void => {
+    if (done) return
+    done = true
+    res.off('close', finish)
+    res.off('finish', finish)
+    cleanup()
+  }
+  res.once('close', finish)
+  res.once('finish', finish)
+}
+
+function closeServer(server: Server, sockets: Set<Socket>): Promise<void> {
+  for (const socket of sockets) socket.destroy()
+  return new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()))
+}
+
+function track(server: Server, maxConnections = MAX_CONNECTIONS): Set<Socket> {
+  const sockets = new Set<Socket>()
+  server.maxConnections = maxConnections
+  server.on('connection', (socket) => {
+    if (sockets.size >= maxConnections) { socket.destroy(); return }
+    sockets.add(socket); socket.once('close', () => sockets.delete(socket))
+  })
+  return sockets
+}
+
+export async function startEgressProxy(options: EgressProxyOptions): Promise<EgressProxyHandle> {
+  const bindAddress = options.bindAddress ?? '0.0.0.0'
+  const proxyPort = options.proxyPort ?? 3128
+  const controlSocketPath = options.controlSocketPath ?? CONTROL_SOCKET
+  const staticConnect = new Set(options.allowConnect.map((item) => {
+    const authority = normalizeAuthority(item)
+    return authorityKey(authority.host, authority.port)
+  }))
+  const staticHttp = new Map(normalizeRules(options.allowHttp).map((rule) => [authorityKey(rule.host, rule.port), rule]))
+  const grants = new Map<string, Grant>()
+  const revokeGrant = (id: string): void => {
+    const grant = grants.get(id)
+    if (!grant) return
+    grants.delete(id)
+    clearTimeout(grant.expires)
+    for (const abort of grant.aborters) abort()
+  }
+  const ingressGrants = new Map<string, IngressGrant>()
+  const revokeIngress = (id: string): void => {
+    const grant = ingressGrants.get(id)
+    if (!grant) return
+    ingressGrants.delete(id)
+    clearTimeout(grant.expires)
+    for (const abort of grant.aborters) abort()
+  }
+  const renewGrant = (id: string): boolean => {
+    const grant = grants.get(id)
+    if (!grant) return false
+    clearTimeout(grant.expires)
+    grant.expires = setTimeout(() => revokeGrant(id), GRANT_TTL_MS)
+    grant.expires.unref()
+    return true
+  }
+  const renewIngress = (id: string): boolean => {
+    const grant = ingressGrants.get(id)
+    if (!grant) return false
+    clearTimeout(grant.expires)
+    grant.expires = setTimeout(() => revokeIngress(id), GRANT_TTL_MS)
+    grant.expires.unref()
+    return true
+  }
+  const targetHost = normalizeHost(options.ingressTargetHost)
+  const ingress = options.ingress ?? []
+  const ingressServers: Array<{ server: Server; sockets: Set<Socket>; port: number }> = []
+
+  const proxy = createServer((req, res) => {
+    void (async () => {
+      const target = parseTarget(req.url)
+      if (!target) { sendStatus(res, 403); return }
+      const authority = authorityKey(target.host, target.port)
+      const staticRule = staticHttp.get(authority)
+      const grant = [...grants.values()].find((item) => authorityKey(item.host, item.port) === authority && item.path === target.path && compareToken(bearerToken(req.headers.authorization), item.token))
+      if (!staticRule && !grant) { sendStatus(res, 403); return }
+      if (staticRule && !staticRule.paths.has(target.path) && !grant) { sendStatus(res, 403); return }
+      if (grant ? req.method !== 'POST' : !methodAllowed(target.path, req.method)) { sendStatus(res, 405); return }
+      let address: string
+      try { address = await resolveSafe(target.host) } catch { sendStatus(res, 403); return }
+      const headers = cleanHeaders(req.headers)
+      headers.host = authority
+      headers.connection = 'close'
+      const upstream = request({ hostname: address, port: target.port, method: req.method, path: target.path, headers }, (response) => {
+        upstream.setTimeout(0)
+        const responseHeaders = cleanHeaders(response.headers)
+        res.writeHead(response.statusCode ?? 502, responseHeaders)
+        response.pipe(res)
+      })
+      const abort = (): void => { upstream.destroy() }
+      req.once('aborted', abort); res.once('close', abort)
+      upstream.setTimeout(5000, abort)
+      if (grant) grant.aborters.add(abort)
+      const removeAborter = (): void => { grant?.aborters.delete(abort) }
+      responseCleanup(res, removeAborter)
+      upstream.once('error', () => sendStatus(res, 502))
+      req.pipe(upstream)
+    })().catch(() => sendStatus(res, 502))
+  })
+  const proxySockets = track(proxy)
+  proxy.on('connect', (req, client, head) => {
+    const authority = parseAuthority(req.url)
+    if (!authority || !staticConnect.has(authorityKey(authority.host, authority.port))) { client.end('HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n'); return }
+    void resolveSafe(authority.host).then((address) => {
+      if (client.destroyed) return
+      const upstream = connect({ host: address, port: authority.port })
+      upstream.setTimeout(5000, () => upstream.destroy())
+      upstream.once('connect', () => {
+        upstream.setTimeout(0)
+        client.write('HTTP/1.1 200 Connection Established\r\n\r\n')
+        if (head.length) upstream.write(head)
+        upstream.pipe(client); client.pipe(upstream)
+      })
+      upstream.once('error', () => client.destroy())
+      client.once('close', () => upstream.destroy())
+    }).catch(() => client.end('HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n'))
+  })
+
+  const control = createTcpServer((socket) => {
+    let buffer = ''
+    socket.setTimeout(5000, () => socket.destroy())
+    socket.setEncoding('utf8')
+    socket.on('data', (chunk: string) => {
+      buffer += chunk
+      if (buffer.length > 64 * 1024) { socket.destroy(); return }
+      let newline: number
+      while ((newline = buffer.indexOf('\n')) >= 0) {
+        const line = buffer.slice(0, newline); buffer = buffer.slice(newline + 1)
+        try {
+          const message = JSON.parse(line) as { op?: string; url?: string; token?: string; id?: string; port?: number }
+          if (message.op === 'admit' && typeof message.url === 'string' && typeof message.token === 'string' && message.token.length > 0 && message.token.length <= 4096) {
+            const target = parseTarget(message.url)
+            if (!target || target.path !== '/mcp' || target.port === 80) throw new Error('invalid bridge URL')
+            const id = randomUUID()
+            const expires = setTimeout(() => revokeGrant(id), GRANT_TTL_MS)
+            expires.unref()
+            grants.set(id, { host: target.host, port: target.port, path: '/mcp', token: message.token, aborters: new Set(), expires })
+            socket.write(`${JSON.stringify({ ok: true, id })}\n`); continue
+          }
+          if (message.op === 'revoke' && typeof message.id === 'string') {
+            revokeGrant(message.id)
+            socket.write('{"ok":true}\n'); continue
+          }
+          if (message.op === 'renew' && typeof message.id === 'string') {
+            if (!renewGrant(message.id)) throw new Error('unknown grant')
+            socket.write('{"ok":true}\n'); continue
+          }
+          if (message.op === 'open-ingress' && typeof message.port === 'number') {
+            const targetPort = asPort(message.port, 'ingress targetPort')
+            const mapping = ingress.find((candidate) => candidate.targetPort === targetPort)
+            if (!mapping) throw new Error('unknown ingress target')
+            const id = randomUUID()
+            const token = randomUUID()
+            const expires = setTimeout(() => revokeIngress(id), GRANT_TTL_MS)
+            expires.unref()
+            ingressGrants.set(id, { targetPort, token, aborters: new Set(), expires })
+            socket.write(`${JSON.stringify({ ok: true, id, token, port: mapping.listenPort })}\n`); continue
+          }
+          if (message.op === 'revoke-ingress' && typeof message.id === 'string') {
+            revokeIngress(message.id)
+            socket.write('{"ok":true}\n'); continue
+          }
+          if (message.op === 'renew-ingress' && typeof message.id === 'string') {
+            if (!renewIngress(message.id)) throw new Error('unknown ingress grant')
+            socket.write('{"ok":true}\n'); continue
+          }
+          throw new Error('invalid control request')
+        } catch { socket.write('{"ok":false,"error":"invalid request"}\n') }
+      }
+    })
+  })
+  const controlSockets = track(control)
+  await mkdir(dirname(controlSocketPath), { recursive: true })
+  try { await unlink(controlSocketPath) } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error }
+
+  const listen = (server: Server, port: number, host: string): Promise<number> => new Promise((resolve, reject) => {
+    const onError = (error: Error): void => { server.off('listening', onListening); reject(error) }
+    const onListening = (): void => { server.off('error', onError); resolve((server.address() as import('node:net').AddressInfo).port) }
+    server.once('error', onError); server.once('listening', onListening); server.listen(port, host)
+  })
+  const listenUnix = (server: Server, path: string): Promise<void> => new Promise((resolve, reject) => {
+    const onError = (error: Error): void => { server.off('listening', onListening); reject(error) }
+    const onListening = (): void => { server.off('error', onError); resolve() }
+    server.once('error', onError); server.once('listening', onListening); server.listen(path)
+  })
+  try {
+    const actualProxyPort = await listen(proxy, proxyPort, bindAddress)
+    await listenUnix(control, controlSocketPath)
+    await chmod(controlSocketPath, 0o600)
+    for (const mapping of ingress) {
+      const listenPort = asPort(mapping.listenPort, 'ingress listenPort')
+      const targetPort = asPort(mapping.targetPort, 'ingress targetPort')
+      const server = createServer((req, res) => {
+        void (async () => {
+          const rawToken = req.headers['x-tanstack-sandbox-token']
+          const token = Array.isArray(rawToken) ? undefined : rawToken
+          const grant = [...ingressGrants.values()].find((item) => item.targetPort === targetPort && compareToken(token, item.token))
+          if (!grant) { sendStatus(res, 401); return }
+          if (req.headers.upgrade) { sendStatus(res, 426); return }
+          const headers = cleanHeaders(req.headers)
+          delete headers['x-tanstack-sandbox-token']
+          headers.host = authorityKey(targetHost, targetPort)
+          headers.connection = 'close'
+          const upstream = request({ hostname: targetHost, port: targetPort, method: req.method, path: req.url || '/', headers }, (response) => {
+            upstream.setTimeout(0)
+            const responseHeaders = cleanHeaders(response.headers)
+            res.writeHead(response.statusCode ?? 502, responseHeaders)
+            response.pipe(res)
+          })
+          const abort = (): void => { upstream.destroy() }
+          req.once('aborted', abort); res.once('close', abort)
+          upstream.setTimeout(5000, abort)
+          grant.aborters.add(abort)
+          responseCleanup(res, () => grant.aborters.delete(abort))
+          upstream.once('error', () => sendStatus(res, 502))
+          req.pipe(upstream)
+        })().catch(() => sendStatus(res, 502))
+      })
+      server.on('upgrade', (_request, socket) => socket.end('HTTP/1.1 426 Upgrade Required\r\nConnection: close\r\n\r\n'))
+      const sockets = track(server)
+      const actual = await listen(server, listenPort, options.ingressBindAddress ?? '0.0.0.0')
+      ingressServers.push({ server, sockets, port: actual })
+    }
+    let closeTask: Promise<void> | undefined
+    return {
+      proxyPort: actualProxyPort,
+      controlSocketPath,
+      ingressPorts: ingressServers.map(({ port }) => port),
+      close: () => closeTask ??= (async () => {
+        const errors: Array<unknown> = []
+        for (const id of ingressGrants.keys()) revokeIngress(id)
+        for (const id of grants.keys()) revokeGrant(id)
+        for (const item of ingressServers) { try { await closeServer(item.server, item.sockets) } catch (error) { errors.push(error) } }
+        try { await closeServer(proxy, proxySockets) } catch (error) { errors.push(error) }
+        try { await closeServer(control, controlSockets) } catch (error) { errors.push(error) }
+        try { await unlink(controlSocketPath) } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') errors.push(error) }
+        if (errors.length === 1) throw errors[0]
+        if (errors.length > 1) throw new AggregateError(errors, 'egress proxy close failed')
+      })(),
+    }
+  } catch (error) {
+    const cleanupErrors: Array<unknown> = []
+    for (const item of ingressServers) { try { await closeServer(item.server, item.sockets) } catch (cleanupError) { cleanupErrors.push(cleanupError) } }
+    try { await closeServer(proxy, proxySockets) } catch (cleanupError) { cleanupErrors.push(cleanupError) }
+    try { await closeServer(control, controlSockets) } catch (cleanupError) { cleanupErrors.push(cleanupError) }
+    try { await unlink(controlSocketPath) } catch (cleanupError) { if ((cleanupError as NodeJS.ErrnoException).code !== 'ENOENT') cleanupErrors.push(cleanupError) }
+    if (cleanupErrors.length > 0) throw new AggregateError([error, ...cleanupErrors], 'egress proxy startup and cleanup failed')
+    throw error
+  }
+}
+
+/**
+ * Proxy-container boot contract. The provider writes this JSON environment
+ * variable and starts the bundled file with Node; the Unix control socket is
+ * therefore never exposed as a Docker bind mount.
+ */
+export const EGRESS_PROXY_CONFIG_ENV = 'TANSTACK_EGRESS_PROXY_CONFIG'
+
+if (process.env[EGRESS_PROXY_CONFIG_ENV] !== undefined) {
+  let parsed: EgressProxyOptions
+  try {
+    parsed = JSON.parse(process.env[EGRESS_PROXY_CONFIG_ENV]) as EgressProxyOptions
+  } catch {
+    throw new Error(`egress: ${EGRESS_PROXY_CONFIG_ENV} must contain JSON`) 
+  }
+  const shutdown = async (): Promise<void> => {
+    const handle = await booted
+    await handle.close()
+  }
+  const booted = startEgressProxy(parsed)
+  void booted.catch((error) => { console.error(error); process.exitCode = 1 })
+  process.once('SIGTERM', () => { void shutdown() })
+  process.once('SIGINT', () => { void shutdown() })
+}
