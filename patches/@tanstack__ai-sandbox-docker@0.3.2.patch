+  private async waitForProxy(proxy: Dockerode.Container): Promise<void> {
+    const deadline = Date.now() + 10_000
+    let lastError: unknown
+    while (Date.now() < deadline) {
+      try {
+        await this.proxyControl(proxy, { op: 'revoke', id: '__ready__' })
+        return
+      } catch (error) {
+        lastError = error
+        await new Promise((resolve) => setTimeout(resolve, 100))
+      }
+    }
+    throw new Error('docker: egress proxy control socket did not become ready', {
+      cause: lastError,
+    })
+  }
