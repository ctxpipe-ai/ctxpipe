+    const grant = grants.get(id);
+    if (!grant)
+      return false;
+    clearTimeout(grant.expires);
+    grant.expires = setTimeout(() => revokeGrant(id), GRANT_TTL_MS);
+    grant.expires.unref();
+    return true;
+  };
+  const renewIngress = (id) => {
+    const grant = ingressGrants.get(id);
+    if (!grant)
