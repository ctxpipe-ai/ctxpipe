+  private async stopAndRemoveContainer(container: Dockerode.Container): Promise<void> {
+    try { await container.stop({ t: 5 }) }
+    catch (error) { if (!hasStatus(error, 304) && !hasStatus(error, 404)) throw error }
+    try { await container.remove({ force: true, v: true }) }
+    catch (error) { if (!hasStatus(error, 404)) throw error }
+  }
