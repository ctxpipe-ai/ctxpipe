+  private makeHandle(
+    container: Dockerode.Container,
+    topology?: EgressTopology,
+  ): SandboxHandle {
+    return new DockerHandle({
+      docker: this.docker,
+      container,
+      workdir: this.workdir,
+      forkFactory: this.forkFactory,
+      removeOnDestroy: this.config.removeOnDestroy ?? true,
+      advertisedPortOrigin: this.advertisedPortOrigin,
+      networkPolicy: topology !== undefined,
+      ...(topology
+        ? {
+            portContainer: topology.proxy,
+            ingressByTarget: topology.ingressByTarget,
+            connectPort: (port: number) => this.connectEgressPort(topology, port),
+            hostBridgeAccess: this.hostBridgeAccess(topology.proxy),
+          }
+        : {}),
+      logger: this.config.logger,
+      destroyContainer: () => this.destroy({ id: container.id }),
+    })
+  }
