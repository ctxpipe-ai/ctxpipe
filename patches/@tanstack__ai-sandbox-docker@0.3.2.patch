+   * without that serialization, a concurrent creator is deliberately not a
+   * supported ownership signal and may observe a fail-closed conflict.
+   */
+  private async reclaimPartialEgressTopology(
+    agentName: string,
+    key: string,
+    owner: string,
+    generation: string,
+    signal?: AbortSignal,
+  ): Promise<void> {
+    signal?.throwIfAborted()
+    const inspectOptions: Dockerode.ContainerInspectOptions & { abortSignal?: AbortSignal } = {
+      abortSignal: signal,
+    }
+    try {
+      await this.docker.getContainer(agentName).inspect(inspectOptions)
+      throw new Error('docker: refusing to reclaim egress topology while its agent exists')
+    } catch (error) {
+      if (!hasStatus(error, 404)) throw error
+    }
+    signal?.throwIfAborted()
+
+    const proxy = this.docker.getContainer(dockerName(owner, 'proxy'))
+    const network = this.docker.getNetwork(dockerName(owner, 'network'))
+    let proxyInfo: Dockerode.ContainerInspectInfo | undefined
+    let networkInfo: Dockerode.NetworkInspectInfo | undefined
+    try { proxyInfo = await proxy.inspect(inspectOptions) }
+    catch (error) { if (!hasStatus(error, 404)) throw error }
+    signal?.throwIfAborted()
+    try { networkInfo = await network.inspect() }
+    catch (error) { if (!hasStatus(error, 404)) throw error }
+    signal?.throwIfAborted()
+    if (!proxyInfo && !networkInfo) return
+
+    if (proxyInfo) {
+      this.assertOwnedLabels(
+        `container ${proxyInfo.Id}`,
+        proxyInfo.Config.Labels,
+        key,
+        owner,
+        generation,
+        'proxy',
+      )
+    }
+    if (networkInfo) {
+      this.assertOwnedLabels(
+        `network ${networkInfo.Id}`,
+        networkInfo.Labels,
+        key,
+        owner,
+        generation,
+        'network',
+      )
+      if (!networkInfo.Internal)
+        throw new Error('docker: refusing to reclaim a non-internal egress network')
+      const endpoints = Object.keys(networkInfo.Containers ?? {})
+      if (
+        endpoints.length > (proxyInfo ? 1 : 0) ||
+        (endpoints.length === 1 && endpoints[0] !== proxyInfo?.Id)
+      ) {
+        throw new Error('docker: refusing to reclaim an egress network with foreign endpoints')
+      }
+    }
