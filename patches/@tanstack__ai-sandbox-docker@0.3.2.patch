+  }
+  return clean;
+}
+function parseTarget(raw) {
+  if (!raw)
+    return;
+  let parsed;
+  try {
+    parsed = new URL(raw);
+  } catch {
+    return;
+  }
+  if (parsed.protocol !== "http:" || parsed.username || parsed.password || parsed.hash)
+    return;
+  if (parsed.search)
+    return;
+  const host = normalizeHost(parsed.hostname);
+  const port = parsed.port ? asPort(Number(parsed.port), "port") : 80;
+  const path = parsed.pathname || "/";
+  return { host, port, path, url: `http://${authorityKey(host, port)}${path}` };
+}
+function parseAuthority(raw) {
+  if (!raw || raw.includes("/") || raw.includes("?") || raw.includes("#"))
+    return;
+  try {
+    const parsed = new URL(`http://${raw}`);
+    if (parsed.username || parsed.password || parsed.pathname !== "/" || !parsed.port)
+      return;
+    return normalizeAuthority({ host: parsed.hostname, port: Number(parsed.port) });
+  } catch {
+    return;
+  }
+}
+function sendStatus(res, status, body = "") {
+  if (!res.headersSent)
+    res.writeHead(status, { connection: "close" });
+  res.end(body);
+}
+function bearerToken(value) {
+  const match = typeof value === "string" ? /^Bearer ([^\s]+)$/.exec(value) : undefined;
+  return match?.[1];
+}
+function methodAllowed(path, method) {
+  const verb = method?.toUpperCase();
+  if (path.endsWith("/models"))
+    return verb === "GET" || verb === "HEAD";
+  if (path.endsWith("/chat/completions"))
+    return verb === "POST";
+  return verb === "GET" || verb === "HEAD";
+}
+function responseCleanup(res, cleanup) {
+  let done = false;
+  const finish = () => {
+    if (done)
+      return;
+    done = true;
+    res.off("close", finish);
+    res.off("finish", finish);
+    cleanup();
+  };
+  res.once("close", finish);
+  res.once("finish", finish);
+}
+function closeServer(server, sockets) {
+  for (const socket of sockets)
+    socket.destroy();
+  return new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+}
+function track(server, maxConnections = MAX_CONNECTIONS) {
+  const sockets = new Set;
+  server.maxConnections = maxConnections;
+  server.on("connection", (socket) => {
+    if (sockets.size >= maxConnections) {
+      socket.destroy();
+      return;
+    }
+    sockets.add(socket);
+    socket.once("close", () => sockets.delete(socket));
+  });
+  return sockets;
+}
+async function startEgressProxy(options) {
