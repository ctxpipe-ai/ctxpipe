+  private async proxyControl(
+    proxy: Dockerode.Container,
+    message: Record<string, unknown>,
+  ): Promise<Record<string, unknown>> {
+    const exec = await proxy.exec({
+      Cmd: ['node', '-e', CONTROL_CLIENT, EGRESS_CONTROL_SOCKET],
+      AttachStdin: true,
+      AttachStdout: true,
+      AttachStderr: true,
+    })
+    const stream = await exec.start({ hijack: true, stdin: true })
+    const stdout: Array<Buffer> = []
+    const stderr: Array<Buffer> = []
+    this.docker.modem.demuxStream(
+      stream,
+      new Writable({ write(chunk, _encoding, callback) { stdout.push(chunk as Buffer); callback() } }),
+      new Writable({ write(chunk, _encoding, callback) { stderr.push(chunk as Buffer); callback() } }),
+    )
+    const settled = new Promise<void>((resolve, reject) => {
+      stream.once('end', resolve)
+      stream.once('close', resolve)
+      stream.once('error', reject)
+    })
+    stream.end(`${JSON.stringify(message)}\n`)
+    await settled
+    const info = await exec.inspect()
+    const errorText = Buffer.concat(stderr).toString('utf8').trim()
+    if ((info.ExitCode ?? 1) !== 0) {
+      throw new Error(`docker: egress proxy control failed${errorText ? `: ${errorText}` : ''}`)
+    }
+    const line = Buffer.concat(stdout).toString('utf8').trim()
+    let response: unknown
+    try { response = JSON.parse(line) } catch { throw new Error('docker: invalid egress proxy control response') }
+    if (typeof response !== 'object' || response === null || !('ok' in response))
+      throw new Error('docker: invalid egress proxy control response')
+    if (response.ok !== true) {
+      const detail = 'error' in response && typeof response.error === 'string'
+        ? `: ${response.error}`
+        : ''
+      throw new Error(`docker: egress proxy rejected control request${detail}`)
+    }
+    return response as Record<string, unknown>
+  }
