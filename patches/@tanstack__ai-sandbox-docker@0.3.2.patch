+  private async connectEgressPort(
+    topology: EgressTopology,
+    targetPort: number,
+  ): Promise<import('@tanstack/ai-sandbox').SandboxChannel> {
+    const listenPort = topology.ingressByTarget.get(targetPort)
+    if (!listenPort) {
+      throw new Error(`docker: container port ${targetPort} has no configured egress ingress mapping`)
+    }
+    const info = await topology.proxy.inspect()
+    const hostPort = info.NetworkSettings.Ports[`${listenPort}/tcp`]?.[0]?.HostPort
+    if (!hostPort) throw new Error(`docker: egress proxy port ${listenPort} is not published`)
+    const response = await this.proxyControl(topology.proxy, {
+      op: 'open-ingress',
+      port: targetPort,
+    })
+    try {
+      if (
+        typeof response.id !== 'string' || !response.id ||
+        typeof response.token !== 'string' || !response.token ||
+        (response.port !== undefined && response.port !== listenPort)
+      ) throw new Error('docker: egress proxy returned an invalid ingress grant')
+      const url = new URL(this.advertisedPortOrigin)
+      url.port = hostPort
+      return {
+        url: url.origin,
+        headers: { 'x-tanstack-sandbox-token': response.token },
+        close: this.leasedRevoker(
+          topology.proxy,
+          response.id,
+          'revoke-ingress',
+          'renew-ingress',
+        ),
+      }
+    } catch (error) {
+      if (typeof response.id !== 'string' || !response.id) throw error
+      try {
+        await this.proxyControl(topology.proxy, {
+          op: 'revoke-ingress',
+          id: response.id,
+        })
+      } catch (cleanupError) {
+        throw new AggregateError(
+          [error, cleanupError],
+          'docker: ingress setup and grant cleanup failed',
+        )
+      }
+      throw error
+    }
+  }
