+  const proxyPort = options.proxyPort ?? 3128;
+  const controlSocketPath = options.controlSocketPath ?? CONTROL_SOCKET;
+  const staticConnect = new Set(options.allowConnect.map((item) => {
+    const authority = normalizeAuthority(item);
+    return authorityKey(authority.host, authority.port);
+  }));
+  const staticHttp = new Map(normalizeRules(options.allowHttp).map((rule) => [authorityKey(rule.host, rule.port), rule]));
+  const grants = new Map;
+  const revokeGrant = (id) => {
+    const grant = grants.get(id);
+    if (!grant)
+      return;
+    grants.delete(id);
+    clearTimeout(grant.expires);
+    for (const abort of grant.aborters)
+      abort();
+  };
