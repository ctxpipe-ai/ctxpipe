+  private hostBridgeAccess(proxy: Dockerode.Container): NonNullable<SandboxHandle['hostBridgeAccess']> {
+    return {
+      admit: async ({ url, token }) => {
+        let parsed: URL
+        try { parsed = new URL(url) } catch { throw new Error('docker: invalid host bridge URL') }
+        if (
+          parsed.protocol !== 'http:' || !parsed.hostname || !parsed.port ||
+          parsed.pathname !== '/mcp' || parsed.search || parsed.hash ||
+          parsed.username || parsed.password || !token
+        ) throw new Error('docker: host bridge admission requires an exact HTTP /mcp URL and token')
+        const response = await this.proxyControl(proxy, { op: 'admit', url, token })
+        if (typeof response.id !== 'string' || !response.id)
+          throw new Error('docker: egress proxy admission returned no grant id')
+        const id = response.id
+        return {
+          revoke: this.leasedRevoker(proxy, id, 'revoke'),
+        }
+      },
+    }
+  }
+
+  private leasedRevoker(
+    proxy: Dockerode.Container,
+    id: string,
+    revokeOp: 'revoke' | 'revoke-ingress',
+    renewOp: 'renew' | 'renew-ingress' = 'renew',
+  ): () => Promise<void> {
+    let renewalFailure: unknown
+    let renewalTask: Promise<void> | undefined
+    let revokeTask: Promise<void> | undefined
+    const timer = setInterval(() => {
+      renewalTask = this.proxyControl(proxy, { op: renewOp, id })
+        .then(() => undefined)
+        .catch((error) => {
+          renewalFailure = error
+          clearInterval(timer)
+          this.config.logger?.warn('docker: egress grant renewal failed', {
+            grantId: id,
+            error: error instanceof Error ? error.message : String(error),
+          })
+        })
+    }, 120_000)
+    timer.unref?.()
+    return () => {
+      revokeTask ??= (async () => {
+        clearInterval(timer)
+        await renewalTask
+        let revokeFailure: unknown
+        try {
+          await this.proxyControl(proxy, { op: revokeOp, id })
+        } catch (error) {
+          revokeFailure = error
+        }
+        if (renewalFailure !== undefined && revokeFailure !== undefined) {
+          throw new AggregateError(
+            [renewalFailure, revokeFailure],
+            'docker: egress grant renewal and revocation failed',
+          )
+        }
+        if (revokeFailure !== undefined) throw revokeFailure
+        if (renewalFailure !== undefined) throw renewalFailure
+      })()
+      return revokeTask
+    }
+  }
